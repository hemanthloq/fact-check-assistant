# ---------------------------------------------------------------------------
# Fact-Check Assistant -- copy to .env.local and fill in
# ---------------------------------------------------------------------------

# Postgres with the pgvector extension available.
#   local docker : postgresql://postgres:postgres@localhost:5432/factcheck
#   neon         : postgresql://user:pass@ep-xxx.region.aws.neon.tech/factcheck?sslmode=require
#   supabase     : postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factcheck

# Signing key for session cookies. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# --- Matcher tuning (optional; defaults shown) ------------------------------
# These are measured, not guessed -- see docs/threshold-calibration.md, regenerate
# with `npm run calibrate`. Lower them and the system answers more submissions
# instantly but starts attaching verdicts to claims they do not belong to.

# Cosine similarity a corpus claim must reach to answer a submission outright.
# = worst same-topic false positive observed (0.729) + 0.10 margin.
MATCH_THRESHOLD=0.83
# Lower bar for a claim surfaced by full-text search, which already shares rare stems.
LEXICAL_CONFIRM_THRESHOLD=0.72
# Floor for showing a neighbour as "related, not close enough to rule on".
RELATED_THRESHOLD=0.45

# Max Postgres connections in the pool (keep low on free hosted tiers).
PG_POOL_MAX=10
