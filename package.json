{
  "name": "fact-check-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Semantic fact-check matching over a verified claim corpus (PostgreSQL + pgvector)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "liar:fetch": "tsx scripts/fetch-liar.ts",
    "embed:warm": "tsx scripts/warm-model.ts",
    "test:db": "tsx scripts/test-db.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "db:local": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "bcryptjs": "3.0.3",
    "jose": "6.2.13",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}